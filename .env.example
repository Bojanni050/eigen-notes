# Copy to .env (gitignored). Nothing here is required for the app to start —
# but the API fails closed without NOTES_TOKEN, and every AI feature is absent
# until its role is configured. Those absences are reported on GET /api/meta.

# ---- Storage ---------------------------------------------------------------
# Postgres 16 + pgvector. The compose file publishes it on 5433 so it cannot
# collide with another Postgres on this host.
DATABASE_URL=postgres://eigen_notes:eigen_notes@127.0.0.1:5433/eigen_notes
POSTGRES_USER=eigen_notes
POSTGRES_PASSWORD=eigen_notes
POSTGRES_DB=eigen_notes

# ---- API -------------------------------------------------------------------
# API_PORT / API_HOST apply to a LOCAL run (`npm start`). Inside compose the api
# binds 0.0.0.0:8899 and lets the port publish restrict it — both are fixed in
# docker-compose.yml, so a value here cannot break the container.
API_PORT=8899
API_HOST=127.0.0.1
# Comma-separated bearer tokens. UNSET OR EMPTY MEANS THE API REFUSES EVERY
# REQUEST (fail closed, same posture as gaia-api).
NOTES_TOKEN=

# ---- AI roles --------------------------------------------------------------
# Self-contained by default. `docker compose up -d` starts this app's OWN two
# llama.cpp servers (see docker-compose.yml) with their own volume, and the
# one-shot `models` service downloads the two GGUF files below on first start.
# No other container, service, Ollama or model server on this host is used,
# read from, or changed.
#
#   embeddings : bge-m3                  — multilingual, 1024 dims, CLS pooling, ~0.6 GB
#   chat       : qwen2.5-3b-instruct     — tags/summary and the rerank, ~1.9 GB
#
# These are the names the app reports in GET /api/meta. The *files* and their
# download URLs are set in docker-compose.yml (models service) — change a model
# there, together with the matching `-m /models/...` path on its server.
EMBED_MODEL=bge-m3
EMBED_DIMENSIONS=1024
EMBED_MAX_CHARS=8000
SUMMARY_MODEL=qwen2.5-3b-instruct
RELATED_MODEL=qwen2.5-3b-instruct

# The model SERVER addresses live in docker-compose.yml, fixed per container
# (llm-chat / llm-embed), so a host-oriented value here can never point the
# container at the wrong place. Running the app outside Docker (`npm start`)?
# Give it the published loopback ports on the command line instead:
#
#   LLM_BASE_URL=http://127.0.0.1:11500/v1 \
#   EMBED_BASE_URL=http://127.0.0.1:11501/v1 npm start
#
# Or point both at any external OpenAI-compatible endpoint and run no model
# server at all — the app simply reports which roles it really has.

# How much of a note may leave the machine for a summary call. The full text is
# the point of the feature, so this is a bound, not a redaction.
SUMMARY_MAX_CHARS=4000
