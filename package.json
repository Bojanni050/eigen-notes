{
  "name": "eigen-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal notes app: notes are objects with a kind, AI output is derived and never overwrites them.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/http/server.js",
    "start:local": "node --env-file-if-exists=.env src/http/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:local": "node --env-file-if-exists=.env src/db/migrate.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:pglite": "DB_BACKEND=pglite node --test test/integration/*.test.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  }
}
